# Homarr encryption key
SECRET_ENCRYPTION_KEY=

# Server LAN IP address
SERVER_IP=

# Container timezone for Glances, KoRest & Flaresolverr
TZ=

# Adjust these values to match the intended host user and group.
# Calibre Process User ID
PUID=1000

# Calibre Process Group ID
PGID=1000

# Readest self-hosted configuration

# Public URLs
# Replace these with the HTTPS domains configured in Nginx Proxy Manager.
SUPABASE_PUBLIC_URL=
S3_PUBLIC_ENDPOINT=

READEST_IMAGE=ghcr.io/readest/readest:0.12.16


# Database
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres


# JWT
JWT_EXPIRY=3600
JWT_SECRET=

# Generate these from JWT_SECRET.
ANON_KEY=
SERVICE_ROLE_KEY=

# Kong
KONG_HTTP_PORT=8000
KONG_NGINX_PROXY_PROXY_BUFFER_SIZE=160k
KONG_NGINX_PROXY_PROXY_BUFFERS=64 160k

# Authentication
API_EXTERNAL_URL=
SITE_URL=
ADDITIONAL_REDIRECT_URLS=

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false


# SMTP
# Only required when ENABLE_EMAIL_AUTOCONFIRM=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest


# PostgREST
PGRST_DB_SCHEMAS=public,graphql_public


# MinIO / S3
OBJECT_STORAGE_TYPE=s3
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET_NAME=readest-files


# Storage quotas
STORAGE_FIXED_QUOTA=53687091200
TRANSLATION_FIXED_QUOTA=50000


# Readest deployment policy
READEST_DEPLOYMENT_MODE=self-hosted
READEST_BILLING_ENABLED=false
READEST_EMAIL_IN_ENABLED=false
READEST_EMAIL_IN_REQUIRES_PREMIUM=false
READEST_CLOUD_SYNC_REQUIRES_PREMIUM=false
READEST_TTS_CACHE_REQUIRES_PREMIUM=false


# Navidrome
ND_LOGLEVEL=
ND_SCANSCHEDULE=
ND_SESSIONTIMEOUT=

# Feishin
FEISHIN_SERVER_NAME=
FEISHIN_SERVER_TYPE=
FEISHIN_SERVER_URL=
FEISHIN_SERVER_LOCK=
FEISHIN_ANALYTICS_DISABLED=
